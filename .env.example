# Copy to backend/.env for local development, or .env for Docker Compose.
# No real provider credentials belong in source control or VITE_* variables.
APP_NAME=Samrit
APP_COUNTRY=US
APP_CITY=New York City
APP_LOCALE=en-US
APP_TIMEZONE=America/New_York
DEFAULT_LATITUDE=40.7306
DEFAULT_LONGITUDE=-73.9866
DISTANCE_UNIT=mi
TEMPERATURE_UNIT=F
CURRENCY=USD
TZ=America/New_York
# Set these differently only when running multiple Compose copies on one host.
# COMPOSE_PROJECT_NAME=samrit-alice
BACKEND_PORT=3000
FRONTEND_PORT=5173
PGADMIN_PORT=5050

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=samrit_db
DB_SSL=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=

JWT_SECRET=replace-with-a-long-random-local-secret
PORT=3000
FRONTEND_URL=http://localhost:5173
SUPER_ADMIN_EMAIL=admin@samrit.local
SUPER_ADMIN_PASSWORD=replace-with-a-strong-admin-password
QR_MAX_DISTANCE_METERS=250
UPLOAD_DIR=uploads

# Optional menu vision. Set an available model ID for your provider account.
# The application does not invent a model or claim OCR is running without a key.
GEMINI_MODEL=
GEMINI_API_KEY=
# Optional additional authorized keys, selected round robin without quota retries.
KEY1=
KEY2=
KEY3=
KEY4=
# Optional local Qwen gateway, using a chat-completions-compatible endpoint.
QWEN_BASE_URL=
QWEN_MODEL=

# Optional legacy image/email integrations. Custody photos use local UPLOAD_DIR.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@samrit.example

PGADMIN_EMAIL=admin@samrit.local
PGADMIN_PASSWORD=replace-with-a-local-password
VITE_API_URL=http://localhost:3000
VITE_APP_CITY=New York City
VITE_APP_LOCALE=en-US
VITE_APP_TIMEZONE=America/New_York
VITE_DEFAULT_LATITUDE=40.7306
VITE_DEFAULT_LONGITUDE=-73.9866
VITE_DISTANCE_UNIT=mi
VITE_TEMPERATURE_UNIT=F
VITE_CURRENCY=USD
