{
  "name": "samrit",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "seed:demo": "node scripts/seed-samrit.cjs",
    "test:api": "node scripts/test-samrit-api.cjs",
    "test:ui:smoke": "node scripts/check-ui.cjs",
    "test:voice:live": "node scripts/test-voice-assistant.cjs",
    "test:voice:ui": "node scripts/check-voice-ui.cjs",
    "test": "npm run test:backend && npm run test:frontend && npm run test:handoff",
    "test:backend": "npm --prefix backend test -- --runInBand",
    "test:frontend": "npm --prefix frontend run test:run",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:e2e:realtime": "npm --prefix backend run test:e2e -- --testPathPattern=realtime-events",
    "setup": "node scripts/setup.cjs",
    "doctor": "node scripts/doctor.cjs",
    "share": "node scripts/package-project.cjs",
    "infra:up": "docker compose up -d postgres redis",
    "infra:stop": "docker compose stop postgres redis",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "test:handoff": "node --test scripts/tests/handoff.test.cjs",
    "db:backup": "node scripts/db/backup.cjs",
    "db:migrate": "node scripts/db/migrate.cjs && node scripts/db/backfill.cjs",
    "db:seed": "node scripts/db/seed-catalog.cjs && node scripts/db/import-nyc.cjs && node scripts/db/seed-statistics.cjs",
    "db:import:nyc": "node scripts/db/import-nyc.cjs --refresh",
    "test:database": "node scripts/db/test-database.cjs",
    "test:evidence": "node scripts/test-evidence-api.cjs",
    "test:complete": "node scripts/test-complete-flow.cjs",
    "docs:manual": "node scripts/build-user-manual.cjs"
  },
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arjunrokad7/Samrit.git"
  }
}
